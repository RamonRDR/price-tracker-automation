# Local environment example. The CLI reads env vars, not .env files automatically.
PRICE_TRACKER_DB=./.price-tracker/prices.db
PRICE_TRACKER_TIMEOUT=15
PRICE_TRACKER_RETRIES=2
PRICE_TRACKER_RETRY_DELAY=0.5
PRICE_TRACKER_DELAY=1
PRICE_TRACKER_MAX_PRODUCTS=50

# Optional SMTP. Never commit a real password.
# PRICE_TRACKER_SMTP_HOST=smtp.example.invalid
# PRICE_TRACKER_SMTP_PORT=587
# PRICE_TRACKER_SMTP_FROM=alerts@example.invalid
# PRICE_TRACKER_SMTP_TO=recipient@example.invalid
# PRICE_TRACKER_SMTP_USERNAME=demo-user
# PRICE_TRACKER_SMTP_PASSWORD=REPLACE_WITH_SECRET

# GitHub Actions: variables and encrypted secrets, never a real local .env commit.
# TRACKER_MONITOR_APPROVED=false
# TRACKER_STATE_REPO=your-handle/private-price-state
# TRACKER_STATE_BRANCH=monitor-state
# TRACKER_ALLOWED_HOSTS=demo.example.org
# TRACKER_STATE_TOKEN=REPLACE_WITH_FINE_GRAINED_TOKEN
# TRACKER_PRODUCTS_JSON=[{"url":"https://demo.example.org/product","adapter":"jsonld"}]
